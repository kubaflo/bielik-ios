<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Bielik.ViewModels"
    xmlns:core="clr-namespace:Bielik.Core;assembly=Bielik.Core"
    x:Class="Bielik.Views.DiscoverPage"
    x:DataType="vm:AppState"
    Style="{StaticResource AppPage}"
    Title="Odkrywaj">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="24,14" StrokeThickness="0" StrokeShape="Rectangle" BackgroundColor="{StaticResource Card}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Image Source="official_bielik_logo.png" Aspect="AspectFit" HeightRequest="35" WidthRequest="158"
                       HorizontalOptions="Start" AutomationId="discover-official-logo"
                       SemanticProperties.Description="Logo Bielik AI z oficjalnej strony bielik.ai" />
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="LOKALNY KLIENT" Style="{StaticResource Eyebrow}" FontSize="8"
                           TextColor="{StaticResource AccentInk}" HorizontalTextAlignment="End" />
                    <Label Text="{Binding ClientName}" Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1" AutomationId="discover-scroll">
            <VerticalStackLayout Spacing="24" Padding="0,0,0,26">
                <Grid AutomationId="discover-hero">
                    <AbsoluteLayout InputTransparent="True">
                        <Image Source="official_bielik_background.png" Aspect="AspectFill" AutomationId="discover-official-background"
                               AutomationProperties.IsInAccessibleTree="False"
                               AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" />
                        <Image Source="hero_white_tint.png" Aspect="Fill" AutomationId="discover-gradient-tint"
                               AutomationProperties.IsInAccessibleTree="False"
                               AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" />
                    </AbsoluteLayout>
                    <VerticalStackLayout Padding="24,24,24,26" Spacing="14">
                        <Label Text="POLSKI MODEL. OTWARTE MOŻLIWOŚCI." Style="{StaticResource Eyebrow}"
                               TextColor="{StaticResource AccentInk}" FontSize="9" />
                        <Label Text="Polska AI.&#10;Twój Bielik." Style="{StaticResource Display}"
                               FontSize="36" TextColor="{StaticResource Accent}" LineHeight="1.08"
                               SemanticProperties.HeadingLevel="Level1" AutomationId="discover-title" />
                        <Label Text="Odkrywaj, twórz i rozmawiaj. Bielik działa na Twoim Macu, a Ty korzystasz z niego na telefonie."
                               FontSize="16" LineHeight="1.2" />
                        <Image Source="official_bielik_mascot.png" Aspect="AspectFit" WidthRequest="182" HeightRequest="192"
                               HorizontalOptions="Center" AutomationId="discover-official-illustration"
                               SemanticProperties.Description="Oficjalna ilustracja orła Bielika z bielik.ai" />
                        <VerticalStackLayout Spacing="10">
                            <Button Text="Porozmawiaj z Bielikiem   →" AutomationId="start-chat" Clicked="OnStartChat" />
                            <Button Text="Ustaw lokalny serwer   →" AutomationId="setup-local-server"
                                    Style="{StaticResource OutlineButton}" Clicked="OnSettingsClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="24,0">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="11B" FontFamily="{StaticResource HeadingFont}" FontSize="23" />
                        <Label Text="parametrów" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="100%" FontFamily="{StaticResource HeadingFont}" FontSize="23" />
                        <Label Text="lokalnie" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="3">
                        <Label Text="Polski" FontFamily="{StaticResource HeadingFont}" FontSize="23" />
                        <Label Text="język i kontekst" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="24,0">
                    <Label Text="Co dziś odkryjesz?" Style="{StaticResource SectionTitle}" VerticalOptions="Center"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Grid.Column="1" Text="ZACZNIJ TUTAJ" Style="{StaticResource Eyebrow}" FontSize="8"
                           VerticalOptions="Center" />
                </Grid>
                <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Stretch"
                            BindableLayout.ItemsSource="{Binding Ideas}" Margin="24,-8,24,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="core:PromptIdea">
                            <Border FlexLayout.Basis="48.5%" Padding="16" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="8"
                                           TextColor="{StaticResource AccentInk}" CharacterSpacing="1.2" />
                                    <Label Text="{Binding Title}" FontFamily="{StaticResource BodySemiboldFont}" FontSize="18" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="13" MinimumHeightRequest="40" />
                                    <Button Text="Wypróbuj  →" Style="{StaticResource TextButton}" HorizontalOptions="Start"
                                            CommandParameter="{Binding Id}" AutomationId="{Binding Id, StringFormat='idea-{0}'}"
                                            Clicked="OnIdeaClicked" Padding="0,4" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Border Padding="16" BackgroundColor="{StaticResource NavyLight}" StrokeThickness="0" Margin="24,-12,24,0">
                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                        <Image Source="icon_lock.png" HeightRequest="22" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Twoje dane zostają lokalnie." FontFamily="{StaticResource BodySemiboldFont}" FontSize="16" />
                            <Label Text="Bez konta i klucza API. Rozmowa trafia tylko do skonfigurowanego lokalnego serwera."
                                   Style="{StaticResource Caption}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Image Source="official_speakleash.png" Aspect="AspectFit" WidthRequest="198" HeightRequest="38"
                       HorizontalOptions="Center" AutomationId="official-creator-logo-discover"
                       SemanticProperties.Description="Oficjalne logo SpeakLeash, twórców Bielika" />
                <Label Text="Zainspirowane bielik.ai · Nieoficjalna aplikacja&#10;Model rozwijany przez Fundację SpeakLeash i społeczność."
                       Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="Center" Margin="24,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
